diff --git a/apps/backend/tests/integration/test_tracker_autocreate_status.py b/apps/backend/tests/integration/test_tracker_autocreate_status.py
new file mode 100644
index 0000000..bbdaf11
--- /dev/null
+++ b/apps/backend/tests/integration/test_tracker_autocreate_status.py
@@ -0,0 +1,34 @@
+"""TRACKER_AUTO_STATUS=saved: tailoring must not record an application as applied."""
+
+from typing import Any
+
+from app.config import settings
+from app.database import Database
+from tests.integration.test_tracker_autocreate import (
+    _new_client,
+    _preview_then_confirm,
+)
+
+
+class TestTrackerAutoStatus:
+    async def test_saved_mode_creates_saved_card_without_applied_at(
+        self,
+        isolated_db: Database,
+        sample_resume: dict[str, Any],
+        monkeypatch: Any,
+    ) -> None:
+        monkeypatch.setattr(settings, "tracker_auto_status", "saved")
+        _, job_id, tailored_id = await _preview_then_confirm(isolated_db, sample_resume)
+
+        async with _new_client() as client:
+            board = (await client.get("/api/v1/applications")).json()["columns"]
+
+        assert board["applied"] == []
+        assert len(board["saved"]) == 1
+        card = board["saved"][0]
+        assert card["job_id"] == job_id
+        assert card["resume_id"] == tailored_id
+        assert card["applied_at"] is None  # no submission is claimed
+
+    async def test_default_stays_upstream_compatible(self) -> None:
+        assert type(settings).model_fields["tracker_auto_status"].default == "applied"
